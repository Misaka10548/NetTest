@page "/manual"
@rendermode InteractiveServer

<h1 class="mb-4">手动检测</h1>

<div class="card" style="max-width: 560px;">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">选择探针</label>
            <select class="form-select" @bind="SelectedProbeId">
                <option value="">请选择…</option>
                @foreach (ProbeConfiguration probe in _probes)
                {
                    <option value="@probe.Id">[@probe.Type] @probe.Name</option>
                }
            </select>
        </div>
        <button class="btn btn-primary" disabled="@(_probes.Count == 0 || string.IsNullOrEmpty(SelectedProbeId))" @onclick="TriggerAsync">开始检测</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger mt-3">@_error</div>
}

@code {
    [Inject]
    private AppServices App { get; set; } = default!;

    [Inject]
    private NavigationManager Nav { get; set; } = default!;

    private List<ProbeConfiguration> _probes = new();
    private string SelectedProbeId { get; set; } = "";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _probes = App.Configuration.Probes.All.ToList();
        await Task.CompletedTask;
    }

    private async Task TriggerAsync()
    {
        _error = null;
        ProbeConfiguration? probe = _probes.FirstOrDefault(p => p.Id == SelectedProbeId);
        if (probe is null)
        {
            _error = "请选择探针。";
            return;
        }

        try
        {
            Guid runId = await App.TriggerManualAsync(probe, probe.Id);
            Nav.NavigateTo($"runs/{runId}");
        }
        catch (Exception ex)
        {
            _error = $"触发失败：{ex.Message}";
        }
    }
}
